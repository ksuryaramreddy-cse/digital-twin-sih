# Antarctic Digital Twin Environment Configuration Example

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# FastAPI Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=antarctic_digital_twin

# WebSocket Configuration
VITE_WS_URL=wss://matri-dashboard-1.onrender.com/ws/maitri

# REST API base URL (FastAPI backend)
VITE_API_URL=https://maitri-backend-api-1.onrender.com


